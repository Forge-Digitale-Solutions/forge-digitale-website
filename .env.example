# Postgres du projet Dokploy « infra » (réseau Docker, pas d'accès public).
DATABASE_URI=postgresql://fds_payload:PASSWORD@infra-postgis-rfekdz:5432/fds_payload

# Secret Payload (KeePass). Stable après le premier démarrage.
PAYLOAD_SECRET=

# URL du site vu par le navigateur. En local : http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=https://forgedigitalesolutions.com

# Brevo newsletter (serveur uniquement, jamais NEXT_PUBLIC)
BREVO_API_KEY=
BREVO_LIST_ID=
# Optionnel : template d'email de bienvenue (si absent, inscription seule)
BREVO_WELCOME_TEMPLATE_ID=4
# Optionnel : surcharge pour tests locaux (défaut https://api.brevo.com)
# BREVO_API_BASE=http://127.0.0.1:4010

# Optionnel (dev uniquement) : 2 numéros d'exemple sur /newsletter/ pour captures locales
# NEWSLETTER_ARCHIVE_DEMO=1

# TikTok Login Kit. Brouillon inbox uniquement, jamais de publication directe.
# URI de redirection enregistrée, sans query.
# Prod : https://forgedigitalesolutions.com/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Secret long et aléatoire. Protège /gameplaydev-planner/ et /api/tiktok/*.
TIKTOK_ADMIN_SECRET=
# 32 octets aléatoires, encodés en base64 (openssl rand -base64 32).
# Chiffre les jetons access et refresh au repos (AES-256-GCM) dans /app/media/.tiktok.
TIKTOK_TOKEN_ENC_KEY=
