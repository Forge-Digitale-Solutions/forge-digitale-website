Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Ancienne URL atelier -> rendez-vous. Un saut vers https apex (query conservée).
RewriteRule ^atelier-saint-laurent-medoc(?:\.html|/index\.html)?/?$ https://forgedigitalesolutions.com/rendez-vous-saint-laurent-medoc/ [R=301,L]

# Un saut : http et/ou www -> https apex. `^` matche aussi la homepage (`.` ne matchait pas `/`).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.forgedigitalesolutions\.com [NC]
RewriteRule ^ https://forgedigitalesolutions.com%{REQUEST_URI} [L,R=301]

Redirect 301 /services /
Redirect 301 /about /
Redirect 301 /contact /
Redirect 301 /realisations /

# Anciennes URLs .html -> version avec slash (ex: /blog/x.html -> /blog/x/)

# /404.html ne doit PAS devenir /404/ : ErrorDocument 404 irait en 301 puis bouclerait.
RewriteRule ^404/?$ - [R=404,L]
RewriteRule ^404\.html$ - [L]
RewriteRule ^feed/?$ - [R=404,L]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule . %{REQUEST_FILENAME}%1.html [NC,L]

ErrorDocument 404 /404.html

# Cache navigateur (corrige "durées de mise en cache efficaces" Lighthouse)
<IfModule mod_expires.c>
  ExpiresActive On
  # Assets Next à nom haché = immuables
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML : revalidation rapide (le contenu change)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpe?g|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
